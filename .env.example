# Backend: copy to .env and replace the secret before running.
MONGODB_URI=mongodb://127.0.0.1:27017/brainspace
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:5173
PORT=8000
# Set only behind a known number of trusted reverse proxies.
# TRUST_PROXY_HOPS=1

# Optional AI search. Indexing and questions send source text to OpenAI and incur charges.
RAG_ENABLED=false
# OPENAI_API_KEY=replace-with-your-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
