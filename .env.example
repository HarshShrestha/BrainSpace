# Backend: copy to .env and replace the secret before running.
MONGODB_URI=mongodb://127.0.0.1:27017/brainspace
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:5173
PORT=8000
# Set only behind a known number of trusted reverse proxies.
# TRUST_PROXY_HOPS=1

# Optional AI search. Indexing and questions send source text to Gemini and incur charges.
RAG_ENABLED=false
# GEMINI_API_KEY=replace-with-your-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.8-flash

# Optional: Python 3.10+ executable for the private RAG worker (defaults to python3).
# RAG_PYTHON=/usr/bin/python3
